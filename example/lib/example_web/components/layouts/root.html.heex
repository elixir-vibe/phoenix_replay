<!DOCTYPE html>
<html lang="en" class="antialiased" data-theme={assigns[:theme] || "system"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#ffffff" />
    <.live_title default="Tasks" suffix=" · Example">
      {assigns[:page_title]}
    </.live_title>
    <link
      phx-track-static
      rel="stylesheet"
      href={Volt.static_path(ExampleWeb.Endpoint, "/assets/css/app.css")}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={Volt.static_path(ExampleWeb.Endpoint, "/assets/js/app.js")}
    >
    </script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 font-sans">
    {@inner_content}
  </body>
</html>
